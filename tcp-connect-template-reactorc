#include <errno.h>
#include <netinet/in.h>
#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <sys/epoll.h>
#include <sys/socket.h>
#include <unistd.h>

#define BUFFER_LENGTH 1024
#define MAX_CLIENT_NUM 1024
#define MAX_EVENTS 1024

struct conn_item;



// 这里是函数指针的定义：
// 函数指针是一种特殊的指针类型，它指向一个函数的地址，可以通过函数指针调用函数。
// 定义格式：返回类型 (*函数指针变量名)(参数类型列表);
//
// 回调函数类型：
// 现在不再只传 fd，而是直接传 conn_item。
// conn_item 里面包含 fd、读写 buffer、读写长度和对应 callback。
typedef int (*RCALLBACK)(struct conn_item *conn);

// conn_item 可以理解为一个 Connection：
// listenfd 对应一个 conn_item，用 accept_callback 处理新连接；
// clientfd 对应一个 conn_item，用 recv_callback/send_callback 处理读写。
//
// 和 tcp-connect-template-IO.c 的区别：
// IO 版本中 epoll_event.data.fd 保存的是 fd，mainloop 拿 fd 后再判断 fd 类型。
// Reactor 版本中 epoll_event.data.ptr 保存的是 conn_item*，mainloop 直接拿 Connection 对象。
struct conn_item {
    int fd;

    // rbuffer 保存从 clientfd 读到的数据，wbuffer 保存准备发送的数据。
    char rbuffer[BUFFER_LENGTH];
    int rlen;
    char wbuffer[BUFFER_LENGTH];
    int wlen;

    // listenfd 和 clientfd 的 EPOLLIN 都是“可读事件”，但是含义不同：
    // listenfd 可读 -> 有新连接 -> accept_callback
    // clientfd 可读 -> 有客户端数据 -> recv_callback
    union {
        RCALLBACK accept_callback;
        RCALLBACK recv_callback;
    } recv_t;

    // clientfd 触发 EPOLLOUT 时，用 send_callback 发送 wbuffer。
    RCALLBACK send_callback;
};

static int epfd = -1;
static struct conn_item connlist[MAX_CLIENT_NUM];

int accept_cb(struct conn_item *conn);
int recv_cb(struct conn_item *conn);
int send_cb(struct conn_item *conn);

// 注册或修改 epoll 事件。
// 关键点：ev.data.ptr 保存的是 conn_item*，不是 fd。
// 这样 epoll_wait 返回事件后，mainloop 可以直接拿到 Connection 对象。
//
// epoll_ctl(int epfd, int op, int fd, struct epoll_event *event)
// epfd：epoll 实例的文件描述符。
// op：操作类型，EPOLL_CTL_ADD 表示添加，EPOLL_CTL_MOD 表示修改。
// fd：要加入或修改的 socket 文件描述符。
// event：要监听的事件类型，以及事件发生后返回给用户态的数据。
//
// flag == 1：第一次把 fd 添加到 epoll。
// flag == 0：fd 已经在 epoll 中，只修改它关心的事件。
//
// set_event 直接接收 conn_item*。
// 调用者把 Connection 对象传进来，set_event 把它保存到 ev.data.ptr。
int set_event(struct conn_item *conn, int event, int flag)
{
    struct epoll_event ev;

    ev.events = event;
    // IO 模板中这里写 ev.data.fd = fd。
    // Reactor 模板中这里写 ev.data.ptr = conn。
    // 这样 epoll_wait 返回时，不需要再用 fd 去 connlist 中查找，直接拿到 conn_item。
    //这里是函数指针的使用：ev.data.ptr 是一个 void*，可以存储任何类型的指针。
    //我们把 conn_item* 存储在 ev.data.ptr 中，这样在 epoll_wait 返回事件时
    //可以直接通过 ev.data.ptr 获取到对应的 Connection 对象，而不需要再通过 fd 去查找。
    ev.data.ptr = conn;

    if (flag) {
        return epoll_ctl(epfd, EPOLL_CTL_ADD, conn->fd, &ev);
    }

    return epoll_ctl(epfd, EPOLL_CTL_MOD, conn->fd, &ev);
}

// listenfd 的 EPOLLIN 回调：
// 说明有新的 TCP 连接请求到来，执行 accept，创建 clientfd 对应的 conn_item。
//
// accept(int sockfd, struct sockaddr *addr, socklen_t *addrlen)
// sockfd：监听套接字。
// addr：用于保存客户端地址信息。
// addrlen：客户端地址结构体长度。
// 返回值：新的 clientfd。后续和客户端通信都用 clientfd，不再用 listenfd。
int accept_cb(struct conn_item *conn)
{
    int fd = conn->fd;
    struct sockaddr_in clientaddr;
    socklen_t len = sizeof(clientaddr);
    int clientfd = accept(fd, (struct sockaddr *)&clientaddr, &len);

    if (clientfd < 0) {
        perror("accept");
        return -1;
    }

    if (clientfd >= MAX_CLIENT_NUM) {
        close(clientfd);
        return -1;
    }

    // 这里用 clientfd 作为下标，找到这个连接自己的 conn_item。
    // connlist[clientfd] 就是这个客户端连接的状态对象。
    struct conn_item *client = &connlist[clientfd];

    client->fd = clientfd;
    client->rlen = 0;
    client->wlen = 0;
    memset(client->rbuffer, 0, BUFFER_LENGTH);
    memset(client->wbuffer, 0, BUFFER_LENGTH);

    client->recv_t.recv_callback = recv_cb;
    client->send_callback = send_cb;

    // 新连接默认只监听 EPOLLIN：等客户端发数据。
    // set_event 内部会把 client 保存到 ev.data.ptr。
    if (set_event(client, EPOLLIN, 1) < 0) {
        perror("epoll_ctl add clientfd");
        close(clientfd);
        return -1;
    }

    return clientfd;
}

// clientfd 的 EPOLLIN 回调：
// 说明客户端发来了数据，执行 recv，把数据放入 rbuffer。
//
// recv(int sockfd, void *buf, size_t len, int flags)
// sockfd：客户端连接 fd。
// buf：接收缓冲区。
// len：最多接收多少字节。
// flags：一般填 0。
// 返回值：>0 表示实际收到的字节数；==0 表示连接关闭；<0 表示出错。
int recv_cb(struct conn_item *conn)
{
    char *buffer = conn->rbuffer;
    int idx = conn->rlen;
    //这里 + idx 是为了把新收到的数据追加到 rbuffer 的末尾，而不是覆盖掉之前的数据。
    int count = recv(conn->fd, buffer + idx, BUFFER_LENGTH - idx, 0);

    if (count == 0) {
        printf("disconnect fd=%d\n", conn->fd);
        // 客户端关闭连接时，要先从 epoll 中删除，再 close fd。
        epoll_ctl(epfd, EPOLL_CTL_DEL, conn->fd, NULL);
        close(conn->fd);
        return -1;
    }

    if (count < 0) {
        if (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK) {
            return 0;
        }

        perror("recv");
        epoll_ctl(epfd, EPOLL_CTL_DEL, conn->fd, NULL);
        close(conn->fd);
        return -1;
    }

    conn->rlen += count;

    
#if 0 //echo: need to send
	memcpy(connlist[fd].wbuffer, connlist[fd].rbuffer, connlist[fd].rlen);
	connlist[fd].wlen = connlist[fd].rlen;
	connlist[fd].rlen -= connlist[fd].rlen;
#else
	//	
	kvstrore_request(conn->fd);
	connlist[fd].wlen = strlen(connlist[fd].wbuffer);
	//http_request(&connlist[fd]);
	//http_response(&connlist[fd]);

#endif

	set_event(fd, EPOLLOUT, 0);

    // 这里暂时做 echo：收到什么，就准备回写什么。
    // 后面接 KVStore 时，可以在这里解析命令并生成响应。
    memcpy(conn->wbuffer, conn->rbuffer, conn->rlen);
    conn->wlen = conn->rlen;

    // 有数据要发时，才把事件改成 EPOLLOUT。
    if (set_event(conn, EPOLLOUT, 0) < 0) {
        perror("epoll_ctl mod EPOLLOUT");
        return -1;
    }

    return count;
}

// clientfd 的 EPOLLOUT 回调：
// 说明 socket 当前可写，把 wbuffer 中的数据发送出去。
//
// send(int sockfd, const void *buf, size_t len, int flags)
// sockfd：客户端连接 fd。
// buf：要发送的数据。
// len：要发送的数据长度。
// flags：一般填 0。
int send_cb(struct conn_item *conn)
{
    int count = send(conn->fd, conn->wbuffer, conn->wlen, 0);

    if (count < 0) {
        if (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK) {
            return 0;
        }

        perror("send");
        epoll_ctl(epfd, EPOLL_CTL_DEL, conn->fd, NULL);
        close(conn->fd);
        return -1;
    }

    conn->rlen = 0;
    conn->wlen = 0;
    memset(conn->rbuffer, 0, BUFFER_LENGTH);
    memset(conn->wbuffer, 0, BUFFER_LENGTH);

    // 发送完成后取消 EPOLLOUT，重新监听 EPOLLIN。
    // 否则 EPOLLOUT 通常会一直触发，造成空转。
    if (set_event(conn, EPOLLIN, 0) < 0) {
        perror("epoll_ctl mod EPOLLIN");
        return -1;
    }

    return count;
}

// 统一事件分发：
// mainloop 不再判断 connfd == sockfd。
// 因为 listenfd 的 recv_t 里保存的是 accept_cb，
// clientfd 的 recv_t 里保存的是 recv_cb。
int handle_event(struct conn_item *conn, uint32_t events)
{
    if (events & (EPOLLERR | EPOLLHUP)) {
        epoll_ctl(epfd, EPOLL_CTL_DEL, conn->fd, NULL);
        close(conn->fd);
        return -1;
    }

    if (events & EPOLLIN) {
        return conn->recv_t.recv_callback(conn);
    }

    if (events & EPOLLOUT) {
        return conn->send_callback(conn);
    }

    return 0;
}

int main(void)
{
    // 创建一个 TCP 套接字。
    // socket(AF_INET, SOCK_STREAM, 0)
    // AF_INET：IPv4。
    // SOCK_STREAM：TCP 字节流。
    // 0：使用默认协议。
    int sockfd = socket(AF_INET, SOCK_STREAM, 0);
    if (sockfd < 0) {
        perror("socket");
        return -1;
    }

    int reuse = 1;
    setsockopt(sockfd, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse));

    // 定义服务器地址结构体。
    struct sockaddr_in serveraddr;
    memset(&serveraddr, 0, sizeof(serveraddr));

    serveraddr.sin_family = AF_INET;
    serveraddr.sin_port = htons(8080);
    serveraddr.sin_addr.s_addr = htonl(INADDR_ANY);

    // bind：把监听套接字绑定到 IP 和端口。
    // 这里绑定到 0.0.0.0:8080，表示监听本机所有网卡的 8080 端口。
    if (bind(sockfd, (struct sockaddr *)&serveraddr, sizeof(serveraddr)) < 0) {
        perror("bind");
        close(sockfd);
        return -1;
    }

    // listen：把 socket 变成监听套接字。
    // backlog 参数表示内核连接队列的最大长度。
    if (listen(sockfd, 10) < 0) {
        perror("listen");
        close(sockfd);
        return -1;
    }

    // epoll_create：创建 epoll 实例，返回 epoll 文件描述符。
    // 参数在现代 Linux 内核中已经基本没有实际意义，传大于 0 的值即可。
    epfd = epoll_create(1);
    if (epfd < 0) {
        perror("epoll_create");
        close(sockfd);
        return -1;
    }

    // listenfd 也封装成一个 conn_item。
    // 对 listenfd 来说，EPOLLIN 的含义不是“有普通数据可读”，而是“有新连接到来”。
    // 所以它的 recv_t 中保存 accept_callback。
    connlist[sockfd].fd = sockfd;
    connlist[sockfd].recv_t.accept_callback = accept_cb;

    // listenfd 注册 EPOLLIN。
    // 当有新连接到来时，epoll_wait 返回这个 conn_item*，
    // handle_event 会调用它的 accept_callback。
    if (set_event(&connlist[sockfd], EPOLLIN, 1) < 0) {
        perror("epoll_ctl add listenfd");
        close(sockfd);
        close(epfd);
        return -1;
    }

    struct epoll_event events[MAX_EVENTS];

    while (1) {
        // mainloop：
        // 1. epoll_wait 等事件
        // 2. 从 events[i].data.ptr 取出 conn_item*
        // 3. 交给 handle_event 分发到 accept_cb/recv_cb/send_cb
        //
        // epoll_wait(int epfd, struct epoll_event *events, int maxevents, int timeout)
        // epfd：epoll 实例。
        // events：用于保存已经发生的事件。
        // maxevents：events 数组大小。
        // timeout：等待时间，-1 表示一直等待。
        int nready = epoll_wait(epfd, events, MAX_EVENTS, -1);
        if (nready < 0) {
            if (errno == EINTR) {
                continue;
            }

            perror("epoll_wait");
            break;
        }

        for (int i = 0; i < nready; i++) {
            // IO 版本：int connfd = events[i].data.fd;
            // Reactor 版本：struct conn_item *conn = events[i].data.ptr;
            //
            // conn 已经包含 fd、buffer、callback，所以 mainloop 不需要再判断 connfd == sockfd。
            struct conn_item *conn = events[i].data.ptr;
            //这里的 ptr 是一个 void*，需要强制转换成 conn_item*，才能访问它的成员。
            //ptr 是 epoll_event 结构体中的一个联合体成员，可以存储任意类型的指针。在这里，我们把 conn_item* 存储在 ptr 中，这样在 epoll_wait 返回事件时，就可以直接通过 ptr 获取到对应的 Connection 对象，而不需要再通过 fd 去查找。
            handle_event(conn, events[i].events);
        }
    }

    close(sockfd);
    close(epfd);

    return 0;
}
